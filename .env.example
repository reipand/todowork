# Todowork environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# `.env.local` is gitignored. Never commit real values, and never put these in a
# mobile bundle's committed config.

# ---------------------------------------------------------------------------------------
# Supabase (client-safe)
# ---------------------------------------------------------------------------------------
# Safe to expose: this key ships in every browser bundle and mobile app by design. It only
# grants the `anon` role, and every table is protected by Row Level Security. Confidentiality
# comes from RLS policies, not from hiding this value.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------------------------------
# Public app URL
# ---------------------------------------------------------------------------------------
# Used for auth redirect links (email confirmation, password reset) and metadata. Must match
# a redirect URL allowed in Supabase Dashboard -> Authentication -> URL Configuration.
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://todowork.reip.my.id

# ---------------------------------------------------------------------------------------
# Feature flags (optional)
# ---------------------------------------------------------------------------------------
# Enables the "Install app" affordance in Settings. Set to "false" if you would rather not
# surface install prompts.
NEXT_PUBLIC_ENABLE_PWA_INSTALL_PROMPT=true

# Seconds a resolved sync conflict record is retained locally before cleanup. Defaults to
# 30 days when unset.
NEXT_PUBLIC_CONFLICT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------------------
# NOT to be placed in .env.local, and never in a NEXT_PUBLIC_* variable
# ---------------------------------------------------------------------------------------
# The following exist in Supabase but MUST NOT appear in this project's environment:
#
#   SUPABASE_SERVICE_ROLE_KEY   Bypasses Row Level Security entirely. It belongs only on a
#                               trusted server. Todowork has no server runtime (static
#                               export), so nothing here should ever need it.
#   DATABASE_URL / postgres://  Direct Postgres connection string. The browser must never
#                               open a direct database connection.
#   SUPABASE_JWT_SECRET        Used to forge session tokens.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the client bundle and readable by anyone.
# If a value is secret, it cannot have that prefix.

# ---------------------------------------------------------------------------------------
# REMINDER: the delete-account Edge Function
# ---------------------------------------------------------------------------------------
# The account-deletion function needs SUPABASE_SERVICE_ROLE_KEY, and it is deliberately NOT
# listed above as a secret for this file. It lives in the Edge Function's own runtime instead:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
#   supabase secrets set DELETE_ACCOUNT_ALLOWED_ORIGINS=https://todowork.reip.my.id
#   supabase functions deploy delete-account
#
# Both secrets must be set BEFORE the deploy, and DELETE_ACCOUNT_ALLOWED_ORIGINS must list the
# exact origin the app is served from, or the browser's CORS preflight fails. Set them once per
# Supabase project — they do not travel with the repo, so a fresh project or a second
# environment needs them set again.
#
# See docs/DEPLOYMENT.md for the curl check that distinguishes "function not deployed" from
# "origin not allowed".

# ---------------------------------------------------------------------------------------
# REMINDER: API gateway (not built yet)
# ---------------------------------------------------------------------------------------
# The app currently calls Supabase directly from the client via supabase-js. A gateway was
# requested but is deliberately unbuilt, and the reason belongs here rather than only in a
# task list, because it constrains what this file can become.
#
# Blocked on a decision, not on effort. The requested gateway wants Next.js API routes — but
# next.config.ts sets `output: 'export'`, which forbids route handlers entirely. Serving an API
# means leaving static export, so the choice is:
#
#   a) split: keep this Next.js app static, add a separate small API service for /api/*; or
#   b) drop `output: 'export'` and host Next.js on a Node runtime.
#
# Until (a) or (b) is chosen, nothing here should gain a server-side env var: this project has
# no server runtime, which is exactly why SUPABASE_SERVICE_ROLE_KEY is absent above. Picking
# (b) would make that key reasonable here; picking (a) would keep it out.
