# Todowork environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# `.env.local` is gitignored. Never commit real values, and never put these in a
# mobile bundle's committed config.

# ---------------------------------------------------------------------------------------
# Supabase (client-safe)
# ---------------------------------------------------------------------------------------
# Safe to expose: this key ships in every browser bundle and mobile app by design. It only
# grants the `anon` role, and every table is protected by Row Level Security. Confidentiality
# comes from RLS policies, not from hiding this value.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------------------------------
# Public app URL
# ---------------------------------------------------------------------------------------
# Used for auth redirect links (email confirmation, password reset) and metadata. Must match
# a redirect URL allowed in Supabase Dashboard -> Authentication -> URL Configuration.
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://tasks.example.com

# ---------------------------------------------------------------------------------------
# Feature flags (optional)
# ---------------------------------------------------------------------------------------
# Enables the "Install app" affordance in Settings. Set to "false" if you would rather not
# surface install prompts.
NEXT_PUBLIC_ENABLE_PWA_INSTALL_PROMPT=true

# Seconds a resolved sync conflict record is retained locally before cleanup. Defaults to
# 30 days when unset.
NEXT_PUBLIC_CONFLICT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------------------
# NOT to be placed in .env.local, and never in a NEXT_PUBLIC_* variable
# ---------------------------------------------------------------------------------------
# The following exist in Supabase but MUST NOT appear in this project's environment:
#
#   SUPABASE_SERVICE_ROLE_KEY   Bypasses Row Level Security entirely. It belongs only on a
#                               trusted server. Todowork has no server runtime (static
#                               export), so nothing here should ever need it.
#   DATABASE_URL / postgres://  Direct Postgres connection string. The browser must never
#                               open a direct database connection.
#   SUPABASE_JWT_SECRET        Used to forge session tokens.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the client bundle and readable by anyone.
# If a value is secret, it cannot have that prefix.
